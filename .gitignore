# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenv
.venv/

# Instruction-init scan artifact (regenerable via scan-project)
.project-snapshot.json

# lsp_harvest sample-mode answer key (generated output, never an input)
scripts/lsp_answers.json

# Local scratch (agent tooling)
.agent-tmp/

# Review working notes (ephemeral — cleared per-branch after commit settlement)
.review/

# Rust build artifacts
/target/
# POC crates carry their own (untracked, detached) target dirs
poc/**/target/
.at-contexts/

# Local marketplace slice (regenerable via scripts/dist-marketplace.sh)
dist/

# npm embedded face: local lockfile testing in plugin/, and binaries
# assembled from wheels (npm/*/bin/ is CI/bootstrap-generated, never
# committed — the repo carries only package.json/README/LICENSE)
node_modules/
npm/*/bin/
npm/*/*.tgz

# v1+ S4 self-owned graph db (dogfood)
.code-reality/

# Last-session observation layer (local session state, not repo content)
STATE.md
