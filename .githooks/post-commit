#!/bin/sh
# post-commit — background reinstall of changed crates (EP
# ep-binary-freshness-face) + background index refresh with burst
# debounce (S4 ep-index-query-time-self-heal). Keeps ~/.cargo/bin in
# sync with HEAD so the freshness WARN never lingers, and keeps
# .code-reality/scip/index.scip stamped at HEAD so scip_refs never
# serves a drifted index. Maintainer-layout path (~/Github/
# code-reality): external users must adapt before opting in
# via `git config core.hooksPath .githooks`.
# Deliberately UNMANAGED (no HOOK_MARKER): `code-reality hook install`
# refuses this file by design — its template carries only the refresh
# block and a future upgrade would silently drop the reinstall block
# below. Any template change (burst debounce, QUIET knob) must be
# hand-ported here; the template is the reference, this file is the
# merge. `code-reality refresh` likewise skips its old-format nudge
# here (no marker) — staleness of this merge is caught by review, not
# by the nudge.
# No per-path gating on the refresh leg by design: refresh already
# re-stamps meta-only on docs-only commits (no re-produce) — an sh
# path filter would duplicate the engine's staleness definition and
# drift from it. The install leg keeps its per-path match (binary
# reinstall has no engine equivalent).
# Matching is per-line (POSIX case patterns anchor both ends — a
# whole-string `*Cargo.toml` arm would only fire when the sorted diff
# happens to END with the root manifest, i.e. never alongside
# lowercase paths; review R1).
log_dir="$HOME/Github/code-reality/.agent-tmp"
mkdir -p "$log_dir"
log="$log_dir/install.log"
changed=$(git diff --name-only HEAD~1 HEAD 2>/dev/null) || changed="all"
inst() {
    echo "$(date '+%F %T') install $1 start" >> "$log"
    cargo install --path "$HOME/Github/code-reality/crates/$1" >> "$log" 2>&1
    echo "$(date '+%F %T') install $1 done" >> "$log"
}
(
    if [ "$changed" = "all" ]; then
        inst code-reality
        inst pyrefly-producer
        inst code-reality-lsp-bridge
    else
        printf '%s\n' "$changed" | while IFS= read -r f; do
            case "$f" in
                crates/code-reality-lsp-bridge/*) inst code-reality-lsp-bridge ;;
                # code-reality changes also rebuild pyrefly-producer (path dep)
                crates/code-reality/*) inst code-reality; inst pyrefly-producer ;;
                # cr-freshness is a path dep of all three WARN-wired crates
                crates/cr-freshness/*) inst code-reality; inst pyrefly-producer; inst code-reality-lsp-bridge ;;
                crates/pyrefly-producer/*) inst pyrefly-producer ;;
                Cargo.toml|Cargo.lock)
                    inst code-reality
                    inst pyrefly-producer
                    inst code-reality-lsp-bridge
                    ;;
            esac
        done
    fi
    echo "$(date '+%F %T') hook done" >> "$log"
) > /dev/null 2>&1 &
# Index refresh leg (hand-port of the `hook install` template — keep in
# sync; see header). Trailing-edge burst debounce: every commit stamps
# refresh.pending; a single detached runner waits for QUIET seconds of
# event silence and refreshes once — a rebase replay or rapid-commit
# burst pays ONE refresh instead of one per event. refresh.scheduled is
# the runner's heartbeat; a marker older than 3xQUIET means the runner
# died and gets respawned. CODE_REALITY_REFRESH_QUIET_SECS overrides
# the quiet window (default 5s). A source-changing lost tail self-heals
# on the next query; a docs-only lost tail re-stamps on the next
# refresh. The bin is the release face ($HOME form for portability —
# the template embeds the absolute path; $HOME is always set even for
# GUI git clients without PATH), never the cargo dev face (it tracks
# this checkout and would WARN on every churn into refresh.log).
REPO=$(git rev-parse --show-toplevel)
DATA="$REPO/.code-reality"
mkdir -p "$DATA"
QUIET=${CODE_REALITY_REFRESH_QUIET_SECS:-5}
case $QUIET in ''|*[!0-9]*) QUIET=5;; esac
date +%s > "$DATA/refresh.pending"
if [ -f "$DATA/refresh.scheduled" ]; then
  sched=$(cat "$DATA/refresh.scheduled" 2>/dev/null || echo 0)
  case $sched in ''|*[!0-9]*) sched=0;; esac
  now=$(date +%s)
  if [ $((now - sched)) -lt $((QUIET * 3)) ]; then
    exit 0
  fi
fi
date +%s > "$DATA/refresh.scheduled"
(
  while :; do
    sleep "$QUIET"
    date +%s > "$DATA/refresh.scheduled"
    last=$(cat "$DATA/refresh.pending" 2>/dev/null || echo 0)
    case $last in ''|*[!0-9]*) last=0;; esac
    now=$(date +%s)
    if [ $((now - last)) -ge "$QUIET" ]; then
      break
    fi
  done
  rm -f "$DATA/refresh.scheduled" "$DATA/refresh.pending"
  nohup "$HOME/.local/bin/code-reality" refresh --repo "$REPO" >> "$DATA/refresh.log" 2>&1 &
) > /dev/null 2>&1 &
exit 0
